{
  "name": "tokenmaxxing",
  "version": "1.0.2",
  "description": "Automatic Claude Code account switching: pool multiple accounts and hot-swap when quota fills, resuming your session on the fresh account.",
  "type": "module",
  "license": "MIT",
  "author": "anaclumos",
  "homepage": "https://github.com/anaclumos/tokenmaxxing",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anaclumos/tokenmaxxing.git"
  },
  "bin": {
    "tokenmaxxing": "./src/main.ts"
  },
  "exports": {
    ".": "./src/sdk.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "DESIGN.md"
  ],
  "engines": {
    "bun": ">=1.2.6"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "scripts": {
    "dev": "bun run src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.214",
    "@chat-adapter/slack": "^4.34.0",
    "@chat-adapter/state-memory": "^4.34.0",
    "chat": "^4.34.0",
    "es-toolkit": "^1.49.0",
    "ky": "^2.0.2",
    "zod": "^4.4.3"
  }
}
