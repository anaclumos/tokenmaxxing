{
  "name": "tokenmaxxing",
  "version": "1.38.0",
  "description": "Automatic Claude Code account switching: pool multiple accounts and hot-swap when quota fills, resuming your session on the fresh account.",
  "type": "module",
  "license": "MIT",
  "author": "anaclumos",
  "homepage": "https://github.com/anaclumos/tokenmaxxing",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anaclumos/tokenmaxxing.git"
  },
  "bin": {
    "tokenmaxxing": "./src/main.ts"
  },
  "files": [
    "src",
    "README.md",
    "DESIGN.md"
  ],
  "engines": {
    "bun": ">=1.3.6"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "scripts": {
    "dev": "bun run src/main.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run typecheck",
    "nix:bun": "bunx bun2nix@2.1.2 -o bun.nix"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "es-toolkit": "^1.49.0",
    "ky": "^2.0.2",
    "zod": "^4.4.3"
  }
}
